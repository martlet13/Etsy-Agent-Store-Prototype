# SpaceCommand public prototype environment template
# Copy this file to .env.local on your own computer.
# Never commit .env.local or real API/account values.

# Optional local image generation
LOCAL_ART_PROVIDER=
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT_NAME=
FORGE_ART_OUTPUT_DIR=
FORGE_DEFAULT_WIDTH=1536
FORGE_DEFAULT_HEIGHT=1024
FORGE_DEFAULT_STEPS=30
FORGE_DEFAULT_CFG=7

# Optional marketplace/account settings
DEFAULT_SHIP_COUNTRY=
DEFAULT_SHIP_STATE=
DEFAULT_SHIP_ZIP=

# Optional APIs. Leave blank until you connect your own accounts.
OPENAI_API_KEY=
ETSY_API_KEY=
ETSY_CLIENT_SECRET=
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=
ETSY_SHOP_ID=
PRINTIFY_API_KEY=
PRINTFUL_API_KEY=
ERANK_API_KEY=
EVERBEE_API_KEY=

# Claude (Anthropic API) - used by _core/llm_backend.py as an alternative
# to a local Ollama model for room-agent text, and to generate Etsy
# listing copy (title/description/tags) in run_scribe_on_design.py.
# Get a key from https://console.anthropic.com. Leave blank to keep
# using Ollama.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Force a backend instead of auto-detecting from ANTHROPIC_API_KEY: claude | ollama
LLM_BACKEND=

# Etsy Open API v3 - used by _core/etsy_api_client.py to create DRAFT
# listings on your own shop only (never activates them). Create your own
# app at https://www.etsy.com/developers/your-apps, set its redirect URI
# to the value below, then run `python _core/run_etsy_oauth_setup.py`
# once. ETSY_API_KEY above is used as the app keystring; ETSY_CLIENT_SECRET
# above is used as the app's shared secret. See docs/SETUP.md.
ETSY_REDIRECT_URI=http://localhost:4522/callback
ETSY_OAUTH_SCOPES=listings_r listings_w shops_r shops_w

# Optional. Only used by _core/run_qwen_edit_style_transfer.py to raise the
# free ZeroGPU quota on the community Hugging Face Space it calls (anonymous
# calls hit "exceeded your ZeroGPU runs limit" almost immediately). Get a
# free token at https://huggingface.co/settings/tokens. Leave blank to call
# anonymously (works, just very rate-limited).
HF_TOKEN=
